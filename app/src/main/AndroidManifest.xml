<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Чтобы честно сказать «ByeDPI установлен/не установлен» на Android 11+ нужен <queries>.
         Второй элемент — приложения с иконкой на рабочем столе: только их вкладка «Туннелирование»
         и показывает (выбрать, что пускать через туннель). С 1.10.32 это вместо разрешения
         QUERY_ALL_PACKAGES («видеть все приложения»): антивирусы (у Samsung — «Защита приложений»
         на движке McAfee) считают его признаком шпионских программ, а нам весь список не нужен. -->
    <queries>
        <package android:name="io.github.dovecoteescapee.byedpi" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Подбор точек для мобильной сети, не уходя с Wi-Fi: попросить у системы мобильную сеть
         рядом с Wi-Fi (requestNetwork). Обычное разрешение, отдельного согласия не нужно. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Разрешения «Установка приложений» (REQUEST_INSTALL_PACKAGES) с 1.10.32 нет: с ним
         1.10.31 «Защита приложений» Samsung назвала вредоносной — приложение, которое само
         скачивает и ставит APK, для антивируса выглядит как «загрузчик». Обновление теперь
         скачивает системная загрузка, а ставит его человек нажатием на файл (см. Updater). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Подбор занимает минуты: пока он идёт, процесс держится foreground-сервисом, иначе
         сворачивание экрана могло оборвать скан, ничего не сказав пользователю. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WarpScout"
        android:usesCleartextTraffic="false">

        <service
            android:name=".ScanGuardService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Разбор «warp-scout://import?…»-ссылок и .conf-файлов, открытых приложением -->
        <activity
            android:name=".ImportActivity"
            android:exported="true"
            android:label="@string/import_title">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Android перемножает атрибуты <data> между собой, поэтому каждый атрибут
                     отдельно: scheme × host × mimeType × pathPattern -->
                <data android:scheme="warp-scout" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="import" />
                <data android:host="*" />
                <data android:mimeType="text/plain" />
                <data android:pathPattern=".*\\.conf" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
