<?xml version="1.0" encoding="utf-8"?>
<!--
  Упрощённый экран: одна большая кнопка (на ней — время и скорость прямо сейчас), туннелирование
  и резервная точка. В шапке — два частых действия: подобрать точку заново и проверить обновления.
  Всё остальное (и выгрузка журнала) — в расширенном режиме (еле заметный тумблер внизу, выбор
  запоминается).

  Тема — как у всего приложения: светлая или тёмная по системе (или по выбору в настройках).
  Фон без анимации: пока экран открыт, он не тратит батарею. В шапке — наш знак и имя, без
  лозунгов. Подписи — только о состоянии: «Подключено», «Выключено», а не «починить» и «обойти».
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/simpleLogo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/shield_desc"
                android:src="@drawable/ic_fox_logo" />

            <TextView
                android:id="@+id/simpleBrand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/simple_brand"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textStyle="bold" />

            <!-- Подобрать точку заново: туннель на время замеров гаснет и возвращается сам. -->
            <ImageButton
                android:id="@+id/simpleRescan"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/simple_rescan_desc"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rescan"
                android:tint="?attr/colorOnSurfaceVariant" />

            <!-- Обновления (с 1.10.31; было «Отправить журнал» — он теперь только в расширенном виде):
                 по нажатию проверить последний релиз, скачать и предложить поставить поверх. -->
            <ImageButton
                android:id="@+id/simpleUpdate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/simple_update_desc"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_update"
                android:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Пустое место над и под кнопкой делится поровну: кнопка стоит в центре экрана. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <FrameLayout
            android:id="@+id/simpleOrb"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:clickable="true"
            android:contentDescription="@string/simple_orb_desc"
            android:focusable="true"
            android:foreground="@drawable/bg_orb_ripple">

            <dev.warpscout.app.PowerOrbView
                android:id="@+id/simpleOrbView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/simplePowerIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_power" />

                <TextView
                    android:id="@+id/simpleState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/simple_state_off"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/simpleTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:visibility="gone"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Скорость прямо сейчас (с 1.10.31): сколько идёт через туннель в эту секунду.
                     Ручного замера больше нет — только живой поток, раз в секунду. -->
                <TextView
                    android:id="@+id/simpleRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Что сейчас делаю (с 1.10.30): ищу точки, проверяю точку с таким-то шумом, проверяю,
             идут ли данные. Видно только пока идёт подбор или подключение. -->
        <TextView
            android:id="@+id/simpleActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

        <TextView
            android:id="@+id/simpleWhere"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <!-- Сообщение о последнем действии: «точка не отвечает», «подключено к …». -->
        <TextView
            android:id="@+id/simpleMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!--
              Туннелирование (с 1.10.31; на этом месте была скорость): что идёт через туннель —
              приложения, сайты или списки. Нажатие открывает шторку с тремя вариантами.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/simpleCardTunnel"
                style="@style/Card.Section"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/simple_tunnel_desc"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/simple_tunnel_title"
                        android:textAllCaps="true"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/simpleTunnelValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/simple_tun_apps_all"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/simpleTunnelSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="2"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/simple_tun_change"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Резервная точка: на неё сервис перейдёт первой, если текущая замолчит. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/simpleCardBackup"
                style="@style/Card.Section"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/simpleBackupTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/simple_backup_title"
                        android:textAllCaps="true"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/simpleBackupValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/simple_backup_none"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/simpleBackupState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="2"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/simple_backup_change"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Еле заметный тумблер режима: нужен редко, и внимание на себя не тянет. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:alpha="0.6"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/simpleModeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_advanced"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/simpleModeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/mode_advanced"
                android:scaleX="0.75"
                android:scaleY="0.75" />
        </LinearLayout>

        <TextView
            android:id="@+id/simpleVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
