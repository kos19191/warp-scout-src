<?xml version="1.0" encoding="utf-8"?>
<!--
  «Приложения» упрощённого экрана (нижняя шторка): кто идёт через туннель. Три режима — все, только
  выбранные, все кроме выбранных; список с иконками и поиском. Ничего не меняется до «Сохранить»:
  при включённом туннеле сохранение переподключает его (список приложений — часть настроек
  VpnService, на лету он не меняется).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sheet_apps_title"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/sheet_apps_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <RadioGroup
        android:id="@+id/appsModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/appsModeAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apps_all" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/appsModeOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apps_only" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/appsModeExcept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apps_except" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/appsListBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/apps_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/appsSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/appsCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Высота задана: список прокручивается сам, шторка остаётся на месте. -->
        <ListView
            android:id="@+id/appsList"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:fastScrollEnabled="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appsCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sheet_apps_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appsSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/sheet_apps_save" />
    </LinearLayout>
</LinearLayout>
