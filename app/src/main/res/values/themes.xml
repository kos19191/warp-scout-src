<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Единственная тема приложения. Всё, что относится к «системе» — цвета, скругления, высота
      элементов — живёт здесь и в dimens/styles, а не в разметке: иначе один и тот же экран
      начинает выглядеть по-разному после каждой правки.
    -->
    <style name="Theme.WarpScout" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>

        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>

        <item name="android:colorBackground">@color/colorSurface</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorSurfaceContainerLowest">@color/colorSurfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/colorSurfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/colorSurfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/colorSurfaceContainerHigh</item>

        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorOutlineVariant</item>

        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <item name="colorErrorContainer">@color/colorErrorContainer</item>
        <item name="colorOnErrorContainer">@color/colorOnErrorContainer</item>

        <!-- Одинаковые скругления во всех компонентах: кнопки, поля, карточки, меню. -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.WarpScout.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.WarpScout.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.WarpScout.Large</item>

        <item name="android:statusBarColor" tools:targetApi="l">@color/colorSurface</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/colorSurface</item>
        <!--
          С 1.10.47. Значки строки состояния и кнопки навигации: тёмные в светлой теме, светлые в тёмной
          (bools.xml и values-night/bools.xml). Панели того же цвета, что фон приложения, а без этого
          значки остаются белыми — на светлом фоне их не видно. Кнопки навигации — с Android 8.1.
        -->
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>
        <!--
          С 1.10.44-beta6. Android 15 у приложений с targetSdk 35 кладёт окна под строку состояния и под
          панель навигации («edge-to-edge»), а экраны WarpScout рассчитаны на окно между ними: внизу
          кнопки «Сохранить», панель вкладок, кнопки шторок — три кнопки навигации их бы закрыли. Окна
          остаются между панелями, как на Android 8–14. На старых версиях атрибута нет — он не читается.
          Если окно всё же легло под панели (так бывает на части телефонов), с 1.10.47 экраны сами
          отступают от них на высоту панелей — см. SystemBars.kt.
        -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>

        <!-- Облик карточек, нижней панели и заголовков разделов (attrs.xml) — классический. -->
        <item name="wsCardBg">@color/colorSurfaceContainerLow</item>
        <item name="wsCardStroke">@color/colorOutlineVariant</item>
        <item name="wsCardRadius">@dimen/radius_card</item>
        <item name="wsPanelBg">@color/colorSurfaceContainer</item>
        <item name="wsPanelStroke">@android:color/transparent</item>
        <item name="wsPanelStrokeWidth">0dp</item>
        <item name="wsPanelRadius">@dimen/radius_panel</item>
        <item name="wsNavBg">@color/colorSurfaceContainerLow</item>
        <item name="wsSectionHeaderAppearance">@style/TextAppearance.WarpScout.SectionHeader</item>

        <!-- Цвета, которые код рисует сам (attrs.xml, с 1.10.49-beta8), — прежние классические. -->
        <item name="wsButtonBg">@color/colorPrimary</item>
        <item name="wsButtonText">@color/colorOnPrimary</item>
        <item name="wsAccent">@color/colorPrimary</item>
        <item name="wsAccentDeep">@color/colorPrimary</item>
        <item name="wsAccentLight">@color/orb_accent</item>
        <item name="wsPartner">@color/orb_accent</item>
        <item name="wsNeonA">@color/orb_accent</item>
        <item name="wsNeonB">@color/orb_accent</item>
        <item name="wsOnSurface">@color/colorOnSurface</item>
        <item name="wsOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="wsOutline">@color/colorOutline</item>
        <item name="wsError">@color/colorError</item>
        <item name="wsBlue">@color/prem_blue</item>
        <item name="wsBg0">@color/colorSurface</item>
        <item name="wsBg1">@color/colorSurface</item>
        <item name="wsDiscA">@color/orb_disc_top</item>
        <item name="wsDiscB">@color/orb_disc_bottom</item>
        <item name="wsRingOff">@color/orb_ring_off</item>
        <item name="wsCore">@android:color/white</item>
        <item name="wsMapBg">@color/prem_map_bg</item>
        <item name="wsMapBlock">@color/prem_map_bg</item>
        <item name="wsMapRoad">@color/prem_map_road</item>
        <item name="wsRouteCore">@android:color/white</item>
    </style>

    <!--
      Дизайн «Премиум» (с 1.10.49-beta7, по умолчанию; выбор — «Настройки» → «Оформление»). Та же тема,
      другие цвета: почти чёрный фон с оранжевым свечением, неоновый оранжевый акцент, стеклянные
      карточки. Светлая и тёмная — как у классического: values / values-night. Фон экрана со свечением
      и диагоналями рисует PremiumBackdrop, кнопку — PowerOrbView (свой вид для «Премиума»).
    -->
    <style name="Theme.WarpScout.Premium" parent="Theme.WarpScout">
        <item name="colorPrimary">@color/prem_accent</item>
        <item name="colorOnPrimary">@color/prem_on_accent</item>
        <item name="colorPrimaryContainer">@color/prem_accent_container</item>
        <item name="colorOnPrimaryContainer">@color/prem_on_accent_container</item>
        <item name="colorSecondary">@color/prem_accent_light</item>
        <item name="colorSecondaryContainer">@color/prem_tonal</item>
        <item name="colorOnSecondaryContainer">@color/prem_on_tonal</item>
        <item name="android:colorBackground">@color/prem_bg0</item>
        <item name="colorSurface">@color/prem_surface</item>
        <item name="colorOnSurface">@color/prem_on_surface</item>
        <item name="colorSurfaceVariant">@color/prem_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/prem_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/prem_surface_lowest</item>
        <item name="colorSurfaceContainerLow">@color/prem_surface_low</item>
        <item name="colorSurfaceContainer">@color/prem_surface_cont</item>
        <item name="colorSurfaceContainerHigh">@color/prem_surface_high</item>
        <item name="colorOutline">@color/prem_outline</item>
        <item name="colorOutlineVariant">@color/prem_outline_variant</item>
        <item name="colorError">@color/prem_error</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/prem_bg1</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/prem_bg1</item>
        <item name="materialButtonStyle">@style/Widget.WarpScout.Premium.Button</item>

        <item name="wsCardBg">@color/prem_card</item>
        <item name="wsCardStroke">@color/prem_card_stroke</item>
        <item name="wsCardRadius">@dimen/radius_card_prem</item>
        <item name="wsPanelBg">@color/prem_card</item>
        <item name="wsPanelStroke">@color/prem_card_stroke</item>
        <item name="wsPanelStrokeWidth">@dimen/stroke_card</item>
        <item name="wsPanelRadius">@dimen/radius_panel_prem</item>
        <item name="wsNavBg">@color/prem_nav</item>
        <item name="wsSectionHeaderAppearance">@style/TextAppearance.WarpScout.SectionHeader.Premium</item>

        <!-- Цвета, которые код рисует сам (с 1.10.49-beta8 — из темы), — те же премиум-цвета. -->
        <item name="wsButtonBg">@color/prem_accent_deep</item>
        <item name="wsButtonText">@color/prem_on_accent</item>
        <item name="wsAccent">@color/prem_accent</item>
        <item name="wsAccentDeep">@color/prem_accent_deep</item>
        <item name="wsAccentLight">@color/prem_accent_light</item>
        <item name="wsPartner">@color/prem_accent_light</item>
        <item name="wsNeonA">@color/prem_accent</item>
        <item name="wsNeonB">@color/prem_accent_light</item>
        <item name="wsOnSurface">@color/prem_on_surface</item>
        <item name="wsOnSurfaceVariant">@color/prem_on_surface_variant</item>
        <item name="wsOutline">@color/prem_outline</item>
        <item name="wsError">@color/prem_error</item>
        <item name="wsBlue">@color/prem_blue</item>
        <item name="wsBg0">@color/prem_bg0</item>
        <item name="wsBg1">@color/prem_bg1</item>
        <item name="wsDiscA">@color/prem_disc_a</item>
        <item name="wsDiscB">@color/prem_disc_b</item>
        <item name="wsRingOff">@color/prem_ring_off</item>
        <item name="wsCore">@color/prem_core</item>
        <item name="wsMapBg">@color/prem_map_bg</item>
        <item name="wsMapBlock">@color/prem_map_bg</item>
        <item name="wsMapRoad">@color/prem_map_road</item>
        <item name="wsRouteCore">@color/prem_core</item>
    </style>

    <!--
      Дизайн «Нежный» (с 1.10.49-beta8): светлая пастель, круглые карточки, мягкие тени. Общая часть —
      здесь, цвета — у каждого из шести оттенков (themes_designs.xml, его пишет tools/design_palettes.py).
      Фон с акварельными пятнами и волнами рисует DesignBackdrop, кнопку — SoftOrbPainter.
    -->
    <style name="Theme.WarpScout.Soft" parent="Theme.WarpScout">
        <item name="materialButtonStyle">@style/Widget.WarpScout.Design.Button</item>
        <item name="wsCardRadius">@dimen/radius_card_soft</item>
        <item name="wsPanelRadius">@dimen/radius_panel_soft</item>
        <item name="wsPanelStrokeWidth">@dimen/stroke_card</item>
        <item name="wsSectionHeaderAppearance">@style/TextAppearance.WarpScout.SectionHeader.Soft</item>
    </style>

    <!--
      Дизайн «Стекло» (с 1.10.49-beta8): полупрозрачные карточки поверх неонового света, кольцо из двух
      неоновых цветов. Цвета — у каждого из пяти сочетаний (themes_designs.xml). Фон — DesignBackdrop,
      кнопка — GlassOrbPainter.
    -->
    <style name="Theme.WarpScout.Glass" parent="Theme.WarpScout">
        <item name="materialButtonStyle">@style/Widget.WarpScout.Design.Button</item>
        <item name="wsCardRadius">@dimen/radius_card_glass</item>
        <item name="wsPanelRadius">@dimen/radius_panel_glass</item>
        <item name="wsPanelStrokeWidth">@dimen/stroke_card</item>
        <item name="wsSectionHeaderAppearance">@style/TextAppearance.WarpScout.SectionHeader.Premium</item>
    </style>

    <!--
      Начальные экраны (бета, с 1.10.44-beta6; WelcomeScreens): окно во весь экран поверх главного — та же
      тема, только с непрозрачным фоном и поджатием под клавиатуру (поиск по приложениям): список
      становится короче, кнопки внизу остаются видны.
    -->
    <style name="Theme.WarpScout.Welcome" parent="Theme.WarpScout">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/colorSurface</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <!-- То же окно во весь экран в дизайне «Премиум» (начальные экраны, с 1.10.49-beta7 — и «Маршрут»). -->
    <style name="Theme.WarpScout.Premium.Welcome" parent="Theme.WarpScout.Premium">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/prem_bg0</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="ShapeAppearance.WarpScout.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_small</item>
    </style>

    <style name="ShapeAppearance.WarpScout.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <style name="ShapeAppearance.WarpScout.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_panel</item>
    </style>
</resources>
