<resources>
    <!-- Заголовок раздела: один размер и один отступ на всех вкладках. -->
    <style name="SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xl</item>
        <item name="android:layout_marginBottom">@dimen/space_xs</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <!-- Пояснение под заголовком: тише основного текста, но не бледнее читаемого. -->
    <style name="Text.Caption" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!--
      Моноширинный текст — для endpoint'ов, конфигов и журнала. Пропорциональный шрифт заставляет
      цифры и адреса «прыгать» при каждом обновлении, а конфиг — читать построчно глазами.
    -->
    <style name="Text.Mono" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">@dimen/text_mono</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <!-- Карточка-раздел: одна рамка и одно скругление на весь интерфейс. -->
    <style name="Card.Section" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="strokeWidth">@dimen/stroke_card</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
    </style>

    <!-- Крупная панель (статус, итог подбора): заметнее обычного раздела, но без тени. -->
    <style name="Card.Panel" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_panel</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
    </style>

    <!--
      Пункт нижней панели. Обычная кнопка, а не пункт BottomNavigationView: у панели навигации
      слишком много собственной механики (меню, иконки, презентер, состояние выбора), и любая
      ошибка в ней роняет весь экран ещё до первого нажатия. Здесь шесть кнопок и один обработчик —
      ломаться нечему. С 1.10.49-beta5 вкладок шесть, и «Настройки» на узком экране или с крупным
      шрифтом не влезали: подпись сама уменьшается (до 9sp) и всегда в одну строку.
    -->
    <style name="Widget.WarpScout.NavButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_height">@dimen/nav_height</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">9sp</item>
        <item name="autoSizeMaxTextSize">12sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <!--
      «Настройки» гармошкой (с 1.10.49-beta5). Заголовок раздела — строка во всю ширину: название,
      под ним что внутри, справа стрелка. Нажатие раскрывает или сворачивает раздел, раскрытые
      запоминаются (SettingsAccordion). Тело раздела видно, пока код его не свернул: если что-то
      пойдёт не так, настройки останутся на виду, а не спрячутся.
    -->
    <style name="SettingsGroupHead" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SettingsGroupTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <style name="SettingsGroupSummary" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="SettingsGroupArrow" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginStart">@dimen/space_s</item>
        <item name="android:src">@drawable/ic_chevron_down</item>
        <item name="android:tint">?attr/colorOnSurfaceVariant</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="SettingsGroupBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingBottom">@dimen/space_m</item>
    </style>

    <style name="SettingsGroupDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <!-- Подзаголовок внутри раздела «Настроек»: «Сеть и DNS», «Шум / обфускация (AWG)». -->
    <style name="SettingsSubHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_m</item>
        <item name="android:layout_marginBottom">@dimen/space_xs</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
