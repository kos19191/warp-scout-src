<?xml version="1.0" encoding="utf-8"?>
<!-- Приватный ключ и настройки аккаунта не должны покидать устройство. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="warpscout.xml" />
        <exclude domain="file" path="configs/" />
        <exclude domain="file" path="reports/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="warpscout.xml" />
        <exclude domain="file" path="configs/" />
    </device-transfer>
</data-extraction-rules>
