<?xml version="1.0" encoding="utf-8"?>
<!--
  Знак WarpScout: щит с мордой лисы в анфас, из простых геометрических фигур.

  Из чего собрано:
    • щит — рыжая кромка, тёмный зазор и почти чёрное поле (кромка + зазор = один контур
      с правилом evenOdd, поэтому «зазор» — это настоящая дырка, а не подкраска под фон:
      знак одинаково выглядит и на тёмной иконке, и на светлой карточке в приложении);
    • поле — два оттенка, левая половина светлее: это даёт объём без градиентов;
    • лиса — рыжая голова с острыми скулами, белые клинья-«усы», белая морда, тёмные глаза
      и нос; белое в ушах — тонкие прожилки.

  Три цвета: рыжий #F6821F, почти чёрный #1E1813, белый. Всё содержимое сжато группой до
  безопасного круга 66dp из 108dp, поэтому адаптивная маска (круг, квадрат со скруглением,
  капля) ничего не срезает.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.82"
        android:scaleY="0.82">

        <!-- Кромка щита: внешний контур без внутреннего (evenOdd). -->
        <path
            android:fillColor="#F6821F"
            android:fillType="evenOdd"
            android:pathData="M26.5,25 L81.5,25 L81.5,50.62 C81.5,72.56 71.05,83 54,86 C36.95,83 26.5,72.56 26.5,50.62 Z M30.5,30 L77.5,30 L77.5,51.63 C77.5,70.15 68.57,78.5 54,81.5 C39.43,78.5 30.5,70.15 30.5,51.63 Z" />

        <!-- Поле: две половины разного оттенка. -->
        <path
            android:fillColor="#1B1611"
            android:pathData="M54,30.5 L31,30.5 L31,51.71 C31,69.87 39.74,78 54,81 Z" />
        <path
            android:fillColor="#241C15"
            android:pathData="M54,30.5 L77,30.5 L77,51.71 C77,69.87 68.26,78 54,81 Z" />

        <!-- Уши. -->
        <path
            android:fillColor="#F6821F"
            android:pathData="M40,36 L47,52 L35,57 Z" />
        <path
            android:fillColor="#F6821F"
            android:pathData="M68,36 L61,52 L73,57 Z" />

        <!-- Голова с острыми скулами. -->
        <path
            android:fillColor="#F6821F"
            android:pathData="M54,43 L64,51 L68,59 L62,61 L54,79 L46,61 L40,59 L44,51 Z" />

        <!-- Белые клинья-«усы». -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M45.5,57 L48.5,62 L37,63 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M62.5,57 L59.5,62 L71,63 Z" />

        <!-- Морда. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M48.8,62.5 L59.2,62.5 L54,77.5 Z" />

        <!-- Прожилки в ушах. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M42,43 L45,50.5 L40,53 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M66,43 L63,50.5 L68,53 Z" />

        <!-- Глаза. -->
        <path
            android:fillColor="#1B1611"
            android:pathData="M47.6,52 L50.6,54.7 L47.6,57.4 L44.6,54.7 Z" />
        <path
            android:fillColor="#1B1611"
            android:pathData="M60.4,52 L63.4,54.7 L60.4,57.4 L57.4,54.7 Z" />

        <!-- Нос. -->
        <path
            android:fillColor="#1B1611"
            android:pathData="M51.6,67 L56.4,67 L54,71 Z" />
    </group>
</vector>
