<?xml version="1.0" encoding="utf-8"?>
<!--
  Знак WarpScout: щит и лиса в анфас, из простых геометрических фигур.

  Почему так. Щит — это туннель и защита, лиса — разведка (scout), и вместе они читаются
  с одного взгляда даже в 48dp. Никаких градиентов и мелких деталей: три цвета (рыжий,
  почти чёрный, белый), крупные формы. Всё, что рисуется, умещается в безопасный круг
  диаметром 66dp из 108dp — поэтому адаптивная маска (круг, квадрат со скруглением, капля)
  ничего не обрезает.

  Белое здесь — только «тень-блик»: узкая полоса по левому краю щита и морда. Больше
  белого не нужно, иначе знак начинает выглядеть как чужая иконка.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Тень под щитом: на светлом фоне даёт объём, на тёмном почти незаметна. -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.28"
        android:pathData="M30,33.2 H78 V54 C78,68.5 66,78.6 54,82.6 C42,78.6 30,68.5 30,54 Z" />

    <!-- Тело щита. -->
    <path
        android:fillColor="#F6821F"
        android:pathData="M30,32 H78 V54 C78,68 66,78 54,82 C42,78 30,68 30,54 Z" />

    <!-- Блик по левому краю: «немного тени белым». -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:strokeAlpha="0.35"
        android:strokeLineCap="round"
        android:pathData="M33,37 V54 C33,65 43,74 54,78.4" />

    <!-- Уши: два узких треугольника, отдельно от головы, чтобы силуэт читался. -->
    <path
        android:fillColor="#16130F"
        android:pathData="M43.5,32.5 L49.5,44 L40,46 Z" />
    <path
        android:fillColor="#16130F"
        android:pathData="M64.5,32.5 L58.5,44 L68,46 Z" />

    <!-- Голова: ромб с вытянутым подбородком. -->
    <path
        android:fillColor="#16130F"
        android:pathData="M45,45 L63,45 L60,58 L54,72 L48,58 Z" />

    <!-- Морда. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48.5,58.5 L59.5,58.5 L54,68.5 Z" />

    <!-- Глаза: ромбы, цвет щита — так они видны на чёрной голове. -->
    <path
        android:fillColor="#F6821F"
        android:pathData="M50,50.6 L52.2,52.6 L50,54.6 L47.8,52.6 Z" />
    <path
        android:fillColor="#F6821F"
        android:pathData="M58,50.6 L60.2,52.6 L58,54.6 L55.8,52.6 Z" />

    <!-- Нос. -->
    <path
        android:fillColor="#16130F"
        android:pathData="M52.4,62.6 L55.6,62.6 L54,65.6 Z" />
</vector>
