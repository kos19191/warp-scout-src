<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- На Android 14+ тип foreground-сервиса обязан быть заявлен и разрешён приложением.
         «vpn» в списке разрешённых типов нет (проверено по android.jar: в ServiceInfo нет
         FOREGROUND_SERVICE_TYPE_VPN), поэтому используется specialUse + подтип vpn. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <service
            android:name=".tunnel.WarpVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
