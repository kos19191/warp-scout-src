<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- На Android 14+ тип foreground-сервиса обязан быть заявлен и разрешён приложением.
         «vpn» в списке разрешённых типов нет (проверено по android.jar: в ServiceInfo нет
         FOREGROUND_SERVICE_TYPE_VPN), поэтому используется specialUse + подтип vpn. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Автоподъём после перезагрузки: туннель, который был включён и не выключен вручную,
         поднимается сам (см. tunnel/TunnelAutoStart.kt). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- Туннель живёт в СВОЁМ процессе. Причина: интерфейс и VPN были в одном процессе,
             и любое падение экрана (а он тяжёлый: списки приложений, подбор, экспорт) гасило
             туннель — «приложение вылетело, а вместе с ним и соединение». Теперь падение
             интерфейса VPN не трогает, а падение сервиса не закрывает окно.

             Плата — состояние нельзя передать общей переменной: сервис пишет снимок в файл и
             рассылает уведомление, интерфейс его читает (см. status/TunnelStatusBus.kt).
             Настройки сервису тоже передаются снимком (status/ServiceSettingsStore.kt), а не
             через SharedPreferences: у каждого процесса своя копия настроек в памяти. -->
        <service
            android:name=".tunnel.WarpVpnService"
            android:process=":vpn"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Плитка в быстрых настройках: нажатие — подключить последний конфиг, удержание —
             открыть приложение (через QS_TILE_PREFERENCES ниже). С 1.10.27 туннель есть в обеих
             сборках, поэтому и плитка — в обеих. -->
        <service
            android:name=".tunnel.TunnelTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_tunnel"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Перезагрузка и обновление приложения убивают процесс туннеля. Если перед этим туннель
             работал и его не выключали вручную, приёмник поднимает его снова. Оба события —
             защищённые системные рассылки: подделать их стороннее приложение не может. -->
        <receiver
            android:name=".tunnel.TunnelAutoStart"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Долгое нажатие по плитке: Android открывает активность с этим фильтром. -->
        <activity-alias
            android:name=".tunnel.TilePreferences"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
